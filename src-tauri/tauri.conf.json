{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panelák Tycoon",
  "version": "0.8.0",
  "identifier": "io.smeglofus.panelak",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Panelák Tycoon",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Panelákový tycoon ze sídliště",
    "longDescription": "Sprav panelák na socialistickém sídlišti: vybírej nájemné, spravuj poruchy, přežij normalizaci a doraž až k privatizaci.",
    "copyright": "© smeglofus",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
