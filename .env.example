# Public base URL of the leaderboard API (server/). Copy to .env to use.
#
# Leave this UNSET for the docker-compose deployment: nginx serves the game and
# proxies /api to the backend on the same origin, so a relative path is right.
#
# Set it for builds that have no nginx in front of them — GitHub Pages, and
# later a desktop build. Must be https when the game itself is served over
# https, and the backend needs CORS to allow that origin (it does by default).
#
# VITE_API_BASE=https://api.example.com
