# Copy to .env to use. Read by both docker compose (DOMAIN, CORS_ORIGIN) and
# the Vite build (VITE_API_BASE).

# --- Deployment (docker compose + Traefik) ----------------------------------

# Hostname the game is served on. The api service is published on api.$DOMAIN.
# Only matters behind Traefik; the plain `docker compose up` on :8080 ignores it.
# DOMAIN=panelaak.shelfy.cz

# Origins allowed to call the leaderboard. Unset = answer anyone, which is the
# honest default for a public board with no cookies. A desktop build sends
# `Origin: null`, so include it if you narrow this down.
# CORS_ORIGIN=https://smeglofus.github.io,null

# --- Build-time (Vite) -------------------------------------------------------

# Public base URL of the leaderboard API.
#
# Leave UNSET when the game is served by our nginx (docker compose, whether on
# localhost:8080 or behind Traefik): it proxies /api on the same origin, so a
# relative path is right and no CORS is involved.
#
# Set it for builds with no nginx in front of them — the GitHub Pages copy, and
# later a desktop build, which loads from file:// and has no origin to resolve a
# relative path against.
#
# VITE_API_BASE=https://api.panelaak.shelfy.cz
